<resources>
    <!-- Base application theme. -->
    <style name="Theme.TaxiLog" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/yellow_4</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorContainer">@color/yellow_1</item>
        <item name="colorOnContainer">@color/yellow_4</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/yellow_4</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@android:color/transparent</item>
        <item name="colorOnSecondaryContainer">@color/yellow_4</item>

        <!-- Tertiary brand color (Neutralized) -->
        <item name="colorTertiary">@color/gray_600</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/gray_100</item>
        <item name="android:colorBackground">@color/gray_100</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/gray_200</item>
        <item name="colorOnSurfaceVariant">@color/gray_700</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Customize your theme here. -->
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/hint_day</item>
        <item name="bottomNavigationBackground">@color/light_gray</item>
        <item name="colorBackgroundFloating">@color/white</item>
    </style>
</resources>